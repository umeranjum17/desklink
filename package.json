{
    "name": "desklink",
    "private": true,
    "license": "Apache-2.0",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "tsc --build packages/desktop-host && npm run build --workspace @desklink/axi",
        "smoke": "npm run smoke --workspace @desklink/axi",
        "test": "vitest run",
        "test:engine": "cargo test --manifest-path packages/desktop-host/engine/Cargo.toml"
    },
    "devDependencies": {
        "@types/node": "22.20.4",
        "@types/react": "19.3.0",
        "@types/ws": "8.18.1",
        "react": "19.2.0",
        "react-test-renderer": "19.2.0",
        "typescript": "5.9.3",
        "vitest": "4.1.11"
    }
}
