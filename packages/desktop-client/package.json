{
    "name": "@desklink/react-native",
    "version": "0.5.13",
    "license": "Apache-2.0",
    "repository": {
      "type": "git",
      "url": "https://github.com/umeranjum17/desklink.git",
      "directory": "packages/desktop-client"
    },
    "description": "React Native view that renders and drives a live desklink desktop session",
    "main": "index.ts",
    "types": "index.ts",
    "exports": {
        ".": "./index.ts",
        "./availability": {
            "browser": "./src/availability.web.ts",
            "default": "./src/availability.ts"
        },
        "./app.plugin.js": "./app.plugin.js",
        "./package.json": "./package.json"
    },
    "files": [
        "index.ts",
        "src",
        "!src/**/*.spec.ts",
        "android/build.gradle",
        "android/gradle.properties",
        "android/src/main",
        "ios/*.swift",
        "ios/*.podspec",
        "app.plugin.js",
        "expo-module.config.json",
        "NOTICE",
        "README.md"
    ],
    "peerDependencies": {
        "expo": ">=55",
        "expo-modules-core": ">=55",
        "react": ">=19",
        "react-native": ">=0.83",
        "react-native-webrtc": ">=124"
    },
    "scripts": {
        "test:reconnect": "node test/reconnect-flow.mjs",
        "test:ios": "node test/ios-flow.mjs",
        "test:reattach-race": "node test/reattach-grace-race-flow.mjs"
    },
    "homepage": "https://github.com/umeranjum17/desklink#readme",
    "keywords": [
        "desktop",
        "remote-desktop",
        "webrtc",
        "react-native",
        "expo",
        "ios",
        "android",
        "desklink"
    ]
}
