{
  "name": "@desklink/axi",
  "version": "0.5.0",
  "description": "Agent-facing desktop control CLI",
  "type": "module",
  "bin": {
    "desklink-axi": "bin/desklink-axi.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build --workspace=@desklink/host && tsc",
    "pretest": "npm run build",
    "test": "vitest run",
    "smoke": "node test/smoke.mjs",
    "skill:gen": "node scripts/gen-skill.mjs",
    "skill:check": "node scripts/gen-skill.mjs --check"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pngjs": "6.0.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@desklink/host": "0.5.0",
    "node-datachannel": "0.33.4",
    "playwright-core": "1.62.1",
    "pngjs": "7.0.0"
  },
  "license": "Apache-2.0"
}
