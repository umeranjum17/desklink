.PHONY : src/uinput/trackpad.cpp.o

src/uinput/trackpad.i: src/uinput/trackpad.cpp.i
.PHONY : src/uinput/trackpad.i

# target to preprocess a source file
src/uinput/trackpad.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/libinputtino.dir/build.make CMakeFiles/libinputtino.dir/src/uinput/trackpad.cpp.i
.PHONY : src/uinput/trackpad.cpp.i

src/uinput/trackpad.s: src/uinput/trackpad.cpp.s
.PHONY : src/uinput/trackpad.s

# target to generate assembly for a file
src/uinput/trackpad.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/libinputtino.dir/build.make CMakeFiles/libinputtino.dir/src/uinput/trackpad.cpp.s
.PHONY : src/uinput/trackpad.cpp.s

